# =============================================================================
# Advisory Board Unlimited – miljøvariabler
# Kopiér til .env. Alle integrationer er som standard "mock", så appen kan køre
# hele flowet lokalt uden eksterne konti.
# =============================================================================

# --- Database ----------------------------------------------------------------
# Postgres-forbindelse. (docker-compose overstyrer denne til den medfølgende postgres.)
DATABASE_URL=postgresql://abu:abu@localhost:5432/abu
# Kun docker-compose: adgangskode til den medfølgende Postgres-container.
POSTGRES_PASSWORD=abu

# --- App ---------------------------------------------------------------------
# Offentlig URL til appen (bruges i mails, betalings-redirects og cookie-secure).
APP_URL=http://localhost:3000
# Tving secure-flag på session-cookien: true/false. Tom = automatisk (true hvis APP_URL starter med https).
COOKIE_SECURE=
# Hemmelighed til /api/cron/process-jobs (Authorization: Bearer <værdi>). Tom = ruten er slået fra.
CRON_SECRET=
# Hemmelighed til signerede afmeldingslinks i e-mail/SMS. Sæt en lang, tilfældig værdi i produktion (fx `openssl rand -base64 32`)
# og ændr den ikke senere – ellers holder gamle afmeldingslinks op med at virke. Tom = afledt af DATABASE_URL + CRON_SECRET.
APP_SECRET=
# true = jobkøen og notifikationer (påmindelser, ufærdige tilmeldinger, oprydning) kører hvert minut i selve app-processen.
# Sæt false, hvis en ekstern cron kalder /api/cron/process-jobs hvert minut.
IN_PROCESS_SCHEDULER=true
# "Deltag i mødet" åbner så mange minutter før mødets start (og lukker ved mødets slut).
MEETING_JOIN_EARLY_MINUTES=15
# Mødets længde i minutter (slots er i 30 min trin).
MEETING_DURATION_MINUTES=120
# Slet optagelsen fra lager, når transskriptionen er færdig (GDPR-dataminimering).
DELETE_RECORDINGS_AFTER_TRANSCRIPTION=true

# --- Betaling: mock | frisbii -------------------------------------------------
PAYMENT_PROVIDER=mock
# Frisbii (Reepay) privat API-nøgle (Basic auth).
FRISBII_PRIVATE_KEY=
# Webhook-hemmelighed (til HMAC-SHA256 signatur-verifikation). Webhook-URL: {APP_URL}/api/webhooks/payments
FRISBII_WEBHOOK_SECRET=
FRISBII_API_URL=https://api.reepay.com
FRISBII_CHECKOUT_API_URL=https://checkout-api.reepay.com

# --- CVR-opslag (onboarding): mock | virk | cvrapi ----------------------------------
# PRODUKTION: CVR_PROVIDER=cvrapi (ejerens valg: gratis og nemt, ingen ansøgning). Husk CVR_USER_AGENT nedenfor.
# LOKALT: mock = fiktive demo-virksomheder (virker uden internet; CVR 34000107 er ophørt, 35000100 findes ikke).
# cvrapi = cvrapi.dk (dansk tjeneste, begrænset gratis kvote pr. dag; ved overskridelse kan kunden fortsætte med manuel indtastning).
# virk = Erhvervsstyrelsens "CVR-data - System til System" (alternativ, gratis efter ansøgning). Adapteren er bevaret.
CVR_PROVIDER=mock
CVR_VIRK_USERNAME=
CVR_VIRK_PASSWORD=
# Endpoint for virk (kan overstyres)
CVR_VIRK_URL=http://distribution.virk.dk/cvr-permanent/virksomhed/_search
# Beskriv appen og en kontaktadresse, fx "Advisory Board Unlimited - onboarding (kontakt: it@firma.dk)". Kræves af cvrapi.dk.
CVR_USER_AGENT=

# --- Video: mock | whereby ----------------------------------------------------
VIDEO_PROVIDER=mock
# Whereby Embedded API-nøgle.
WHEREBY_API_KEY=
# Whereby webhook-hemmelighed. Webhook-URL: {APP_URL}/api/webhooks/video
WHEREBY_WEBHOOK_SECRET=
WHEREBY_API_URL=https://api.whereby.dev/v1
# S3-bucket som Whereby skriver optagelser til (typisk samme Hetzner-bucket som STORAGE nedenfor).
WHEREBY_RECORDING_BUCKET=
WHEREBY_RECORDING_ACCESS_KEY_ID=
WHEREBY_RECORDING_SECRET_ACCESS_KEY=

# --- Transskription: mock | mistral -------------------------------------------
TRANSCRIPTION_PROVIDER=mock
MISTRAL_API_KEY=
MISTRAL_API_URL=https://api.mistral.ai/v1
MISTRAL_TRANSCRIPTION_MODEL=voxtral-mini-latest
MISTRAL_SUMMARY_MODEL=mistral-small-latest

# --- E-mail: console | smtp | inmobile ------------------------------------------
# console = mails (inkl. invitationslinks) skrives til serverens log. inmobile = inMobiles e-mail-API (dansk). smtp = vilkårlig SMTP.
EMAIL_PROVIDER=console
EMAIL_FROM="Advisory Board Unlimited <noreply@example.dk>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true = implicit TLS (port 465); false = STARTTLS (port 587)
SMTP_SECURE=false

# --- SMS og inMobile (DK): console | inmobile --------------------------------------
# console = SMS'er skrives til serverens log. inmobile = inMobile API v4 via almindelig fetch (ingen SDK).
SMS_PROVIDER=console
# API-nøgle fra inMobile (bruges til både SMS og e-mail, hvis EMAIL_PROVIDER=inmobile).
INMOBILE_API_KEY=
INMOBILE_API_URL=https://api.inmobile.com
# Hemmelighed i webhook-URL'en. Giv inMobile: {APP_URL}/api/webhooks/inmobile?secret=<værdi> (status og indgående SMS/STOP).
INMOBILE_WEBHOOK_SECRET=
# SMS-afsendernavn: 3-11 tegn, kun bogstaver (a-z) og tal. Kan ændres i CMS'et (Admin → Notifikationer → Indstillinger).
SMS_SENDER=ABUnlimited
# Stille timer for SMS (København-tid), "fra-til" i hele timer. Tom/off = ingen. Kan ændres i CMS'et.
SMS_QUIET_HOURS=21-08
# Opbevaring (GDPR): notifikationslog og leads med samtykke. Kan ændres i CMS'et.
NOTIFICATION_LOG_RETENTION_MONTHS=12
LEAD_RETENTION_MONTHS=24

# --- Fillagring: local | s3 ---------------------------------------------------
STORAGE_PROVIDER=local
# Mappe til lokal lagring (docker: monteret volumen /data/uploads).
UPLOAD_DIR=./uploads
# Hetzner Object Storage, fx https://fsn1.your-objectstorage.com
S3_ENDPOINT=
S3_REGION=eu-central
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
