# =============================================================================
# Advisory Board Unlimited – miljøvariabler
# Kopiér til .env. Alle integrationer er som standard "mock", så appen kan køre
# hele flowet lokalt uden eksterne konti.
# =============================================================================

# --- Database ----------------------------------------------------------------
# Postgres-forbindelse. (docker-compose overstyrer denne til den medfølgende postgres.)
DATABASE_URL=postgresql://abu:abu@localhost:5432/abu
# Kun docker-compose: adgangskode til den medfølgende Postgres-container.
POSTGRES_PASSWORD=abu

# --- App ---------------------------------------------------------------------
# Offentlig URL til appen (bruges i mails, betalings-redirects og cookie-secure).
APP_URL=http://localhost:3000
# Tving secure-flag på session-cookien: true/false. Tom = automatisk (true hvis APP_URL starter med https).
COOKIE_SECURE=
# Hemmelighed til /api/cron/process-jobs (Authorization: Bearer <værdi>). Tom = ruten er slået fra.
CRON_SECRET=
# Mødets længde i minutter (slots er i 30 min trin).
MEETING_DURATION_MINUTES=120
# Slet optagelsen fra lager, når transskriptionen er færdig (GDPR-dataminimering).
DELETE_RECORDINGS_AFTER_TRANSCRIPTION=true

# --- Betaling: mock | frisbii -------------------------------------------------
PAYMENT_PROVIDER=mock
# Frisbii (Reepay) privat API-nøgle (Basic auth).
FRISBII_PRIVATE_KEY=
# Webhook-hemmelighed (til HMAC-SHA256 signatur-verifikation). Webhook-URL: {APP_URL}/api/webhooks/payments
FRISBII_WEBHOOK_SECRET=
FRISBII_API_URL=https://api.reepay.com
FRISBII_CHECKOUT_API_URL=https://checkout-api.reepay.com

# --- Video: mock | whereby ----------------------------------------------------
VIDEO_PROVIDER=mock
# Whereby Embedded API-nøgle.
WHEREBY_API_KEY=
# Whereby webhook-hemmelighed. Webhook-URL: {APP_URL}/api/webhooks/video
WHEREBY_WEBHOOK_SECRET=
WHEREBY_API_URL=https://api.whereby.dev/v1
# S3-bucket som Whereby skriver optagelser til (typisk samme Hetzner-bucket som STORAGE nedenfor).
WHEREBY_RECORDING_BUCKET=
WHEREBY_RECORDING_ACCESS_KEY_ID=
WHEREBY_RECORDING_SECRET_ACCESS_KEY=

# --- Transskription: mock | mistral -------------------------------------------
TRANSCRIPTION_PROVIDER=mock
MISTRAL_API_KEY=
MISTRAL_API_URL=https://api.mistral.ai/v1
MISTRAL_TRANSCRIPTION_MODEL=voxtral-mini-latest
MISTRAL_SUMMARY_MODEL=mistral-small-latest

# --- E-mail: console | smtp ---------------------------------------------------
# console = mails (inkl. invitationslinks) skrives til serverens log.
EMAIL_PROVIDER=console
EMAIL_FROM="Advisory Board Unlimited <noreply@example.dk>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true = implicit TLS (port 465); false = STARTTLS (port 587)
SMTP_SECURE=false

# --- Fillagring: local | s3 ---------------------------------------------------
STORAGE_PROVIDER=local
# Mappe til lokal lagring (docker: monteret volumen /data/uploads).
UPLOAD_DIR=./uploads
# Hetzner Object Storage, fx https://fsn1.your-objectstorage.com
S3_ENDPOINT=
S3_REGION=eu-central
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
