# =============================================================================
# Advisory Board Unlimited – miljøvariabler
# Kopiér til .env. Alle integrationer er som standard "mock", så appen kan køre
# hele flowet lokalt uden eksterne konti.
#
# PRODUKTION ER FAIL-CLOSED (C-1): med NODE_ENV=production (også `next start` og Docker) nægter appen at starte,
# hvis en udbyder er mock/console/local, hvis hemmeligheder mangler, eller hvis en værdi er ukendt. Opstartsloggen
# ([config]) viser præcis hvad der mangler. Ukendte værdier (fx PAYMENT_PROVIDER=frisbi) er altid en fejl.
# =============================================================================

# --- Miljø ---------------------------------------------------------------------
# production | staging | development | test. Tom = production når NODE_ENV=production, ellers development.
# Kun til lokal test af et produktionsbuild med mock-udbydere: APP_ENV=development (logges som ADVARSEL). Aldrig i drift.
APP_ENV=

# --- Database ----------------------------------------------------------------
# Postgres-forbindelse. (docker-compose overstyrer denne til den medfølgende postgres.)
DATABASE_URL=postgresql://abu:abu@localhost:5432/abu
# Kun docker-compose: adgangskode til den medfølgende Postgres-container. Brug en lang, tilfældig værdi i produktion.
POSTGRES_PASSWORD=abu
# Kun tests: separat testdatabase til DB-integrationstests (`npm test`). Tom = DB-tests springes over. Aldrig produktionsdatabasen.
# TEST_DATABASE_URL=postgresql://abu:abu@localhost:5432/abu_test

# --- App ---------------------------------------------------------------------
# Offentlig URL til appen (bruges i mails, betalings-redirects og CSP). Produktion: skal være https og ikke localhost.
APP_URL=http://localhost:3000
# Secure-flag på session-cookien: true/false. Tom = automatisk (true hvis APP_URL starter med https).
# I produktion er cookien ALTID Secure, og COOKIE_SECURE=false afvises af opstartstjekket.
COOKIE_SECURE=
# Antal betroede reverse proxies foran appen (Caddy/nginx = 1; CDN + Caddy = 2). Klient-IP til rate limits tages fra
# X-Forwarded-For talt fra højre, så klienten ikke kan forfalske den. 0 = ingen proxy (X-Forwarded-For ignoreres).
# Kræves ≥ 1 i produktion. Proxyen SKAL sætte/tilføje X-Forwarded-For (Caddy gør det som standard).
TRUSTED_PROXY_HOPS=0
# Hemmelighed til /api/cron/process-jobs (Authorization: Bearer <værdi>). Tom = ruten er slået fra. Produktion: mindst 32 tegn.
CRON_SECRET=
# Hemmelighed til signerede afmeldingslinks i e-mail/SMS (HMAC-SHA256, gyldige i 1 år). Kræves i produktion (mindst 32 tegn,
# fx `openssl rand -base64 48`). Skift den kun bevidst: gamle afmeldingslinks holder op med at virke.
# Tom (kun lokalt) = en tilfældig nøgle pr. proces; links virker så kun til næste genstart.
APP_SECRET=
# true = jobkøen og notifikationer (påmindelser, ufærdige tilmeldinger, oprydning) kører hvert minut i selve app-processen.
# Sæt false, hvis en ekstern cron kalder /api/cron/process-jobs hvert minut.
IN_PROCESS_SCHEDULER=true
# "Deltag i mødet" åbner så mange minutter før mødets start (og lukker ved mødets slut).
MEETING_JOIN_EARLY_MINUTES=15
# Mødets længde i minutter (slots er i 30 min trin).
MEETING_DURATION_MINUTES=120
# Slet optagelsen fra lager, når transskriptionen er færdig (GDPR-dataminimering).
DELETE_RECORDINGS_AFTER_TRANSCRIPTION=true

# --- Betaling: mock | frisbii -------------------------------------------------
PAYMENT_PROVIDER=mock
# Frisbii (Reepay) privat API-nøgle (Basic auth).
FRISBII_PRIVATE_KEY=
# Webhook-hemmelighed: HMAC-SHA256 over den RÅ body + tidsstempel (højst 5 min gammelt). Webhook-URL: {APP_URL}/api/webhooks/payments
# Headerformatet er samlet i src/lib/payments/frisbii-signature.ts og skal tilpasses udbyderen (Frisbii eller Alunta).
FRISBII_WEBHOOK_SECRET=
FRISBII_API_URL=https://api.reepay.com
FRISBII_CHECKOUT_API_URL=https://checkout-api.reepay.com

# --- CVR-opslag (onboarding): mock | virk | cvrapi ----------------------------------
# PRODUKTION: CVR_PROVIDER=cvrapi (ejerens valg: gratis og nemt, ingen ansøgning). Husk CVR_USER_AGENT nedenfor.
# LOKALT: mock = fiktive demo-virksomheder (virker uden internet; CVR 34000107 er ophørt, 35000100 findes ikke).
# cvrapi = cvrapi.dk (dansk tjeneste, begrænset gratis kvote pr. dag; ved overskridelse kan kunden fortsætte med manuel indtastning).
# virk = Erhvervsstyrelsens "CVR-data - System til System" (alternativ, gratis efter ansøgning). Adapteren er bevaret.
CVR_PROVIDER=mock
CVR_VIRK_USERNAME=
CVR_VIRK_PASSWORD=
# Endpoint for virk (kan overstyres)
CVR_VIRK_URL=http://distribution.virk.dk/cvr-permanent/virksomhed/_search
# Beskriv appen og en kontaktadresse, fx "Advisory Board Unlimited - onboarding (kontakt: it@firma.dk)". Kræves af cvrapi.dk.
CVR_USER_AGENT=
# Højst så mange eksterne CVR-opslag pr. døgn i alt (beskytter den fælles gratis kvote). Derefter manuel indtastning.
# Opslag caches i databasen (fundet 24 t, "ikke fundet" 6 t).
CVR_DAILY_BUDGET=300

# --- Video: mock | whereby ----------------------------------------------------
VIDEO_PROVIDER=mock
# Whereby Embedded API-nøgle.
WHEREBY_API_KEY=
# Whereby webhook-hemmelighed. Webhook-URL: {APP_URL}/api/webhooks/video
WHEREBY_WEBHOOK_SECRET=
WHEREBY_API_URL=https://api.whereby.dev/v1
# S3-bucket som Whereby skriver optagelser til (typisk samme Hetzner-bucket som STORAGE nedenfor).
WHEREBY_RECORDING_BUCKET=
WHEREBY_RECORDING_ACCESS_KEY_ID=
WHEREBY_RECORDING_SECRET_ACCESS_KEY=

# --- Transskription: mock | mistral -------------------------------------------
TRANSCRIPTION_PROVIDER=mock
MISTRAL_API_KEY=
MISTRAL_API_URL=https://api.mistral.ai/v1
MISTRAL_TRANSCRIPTION_MODEL=voxtral-mini-latest
MISTRAL_SUMMARY_MODEL=mistral-small-latest

# --- E-mail: console | smtp | inmobile ------------------------------------------
# console = mails (inkl. invitationslinks) skrives til serverens log. inmobile = inMobiles e-mail-API (dansk). smtp = vilkårlig SMTP.
EMAIL_PROVIDER=console
EMAIL_FROM="Advisory Board Unlimited <noreply@example.dk>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true = implicit TLS (port 465); false = STARTTLS (port 587)
SMTP_SECURE=false

# --- SMS og inMobile (DK): console | inmobile --------------------------------------
# console = SMS'er skrives til serverens log. inmobile = inMobile API v4 via almindelig fetch (ingen SDK).
SMS_PROVIDER=console
# API-nøgle fra inMobile (bruges til både SMS og e-mail, hvis EMAIL_PROVIDER=inmobile).
INMOBILE_API_KEY=
INMOBILE_API_URL=https://api.inmobile.com
# Hemmelighed til statuswebhooken (status og indgående SMS/STOP). Helst sendt af inMobile i headeren x-webhook-secret;
# ellers {APP_URL}/api/webhooks/inmobile?secret=<værdi>. Kræves i produktion med inmobile.
INMOBILE_WEBHOOK_SECRET=
# Under rotation: den forrige hemmelighed accepteres også, indtil inMobile er opdateret. Tøm bagefter.
INMOBILE_WEBHOOK_SECRET_PREVIOUS=
# SMS-afsendernavn: 3-11 tegn, kun bogstaver (a-z) og tal. Kan ændres i CMS'et (Admin → Notifikationer → Indstillinger).
# Tilladte SMS-lande (standard kun Danmark) og lofter pr. nummer/døgn sættes også dér, ikke her.
SMS_SENDER=ABUnlimited
# Stille timer for SMS (København-tid), "fra-til" i hele timer. Tom/off = ingen. Kan ændres i CMS'et.
SMS_QUIET_HOURS=21-08
# Opbevaring (GDPR): notifikationslog og leads med samtykke. Kan ændres i CMS'et.
NOTIFICATION_LOG_RETENTION_MONTHS=12
LEAD_RETENTION_MONTHS=24

# --- Fillagring: local | s3 ---------------------------------------------------
# Optagelser og rådgiverfotos (avatars/<id>/….webp, 512 + 96 px, uden EXIF/GPS). Produktion kræver s3: en PRIVAT bucket i
# Hetzner Object Storage – trin for trin i docs/HETZNER-S3.md. Fotos serveres af appen selv (/api/avatar/<id>), aldrig
# direkte fra bucketten. Optagelser uploades direkte fra browseren til bucketten (presigned POST), så bucketten skal have
# en CORS-regel, der tillader POST fra APP_URL. local streamer uploads til disk (kun udvikling).
# Tjek opsætningen med: npm run storage:check (skriver, læser og sletter et testobjekt; tjekker privat bucket og CORS).
STORAGE_PROVIDER=local
# Mappe til lokal lagring (docker: monteret volumen /data/uploads).
UPLOAD_DIR=./uploads
# Hetzner Object Storage-endpoint for jeres location: https://fsn1|nbg1|hel1.your-objectstorage.com
S3_ENDPOINT=
# Samme som location: fsn1, nbg1 eller hel1
S3_REGION=eu-central
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true (standard) = path-style (endpoint/bucket/nøgle); false = virtual-hosted (bucket.endpoint/nøgle). CSP følger med.
S3_FORCE_PATH_STYLE=true
