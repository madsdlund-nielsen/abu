generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ADVISOR
  CUSTOMER
}

enum TokenPurpose {
  INVITE
  RESET
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum MeetingStatus {
  BOOKED
  COMPLETED
  CANCELLED
}

enum RecordingSource {
  WEBHOOK
  UPLOAD
}

enum RecordingStatus {
  RECEIVED
  TRANSCRIBING
  DONE
  FAILED
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  role         Role
  name         String
  phone        String?
  createdAt    DateTime  @default(now())
  /// GDPR: set when the user has asked for deletion; admin processes it.
  deletionRequestedAt DateTime?
  /// GDPR: timestamp of consent to terms/privacy at signup.
  consentAt    DateTime?

  sessions        Session[]
  passwordTokens  PasswordToken[]
  advisorProfile  AdvisorProfile?
  customerProfile CustomerProfile?
  participations  MeetingParticipant[]
  auditLogs       AuditLog[]
}

model Session {
  /// SHA-256 hex of the random cookie token.
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordToken {
  id        String       @id @default(cuid())
  userId    String
  tokenHash String       @unique
  purpose   TokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AdvisorProfile {
  userId    String   @id
  title     String   @default("")
  bio       String   @default("")
  photoUrl  String   @default("")
  active    Boolean  @default(true)
  /// Pris pr. møde i hele kroner, ekskl. moms. Sættes af admin. Fastfryses på abonnementet ved køb.
  pricePerMeetingDkk Int @default(1750)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  availabilityRules  AvailabilityRule[]
  availabilityBlocks AvailabilityBlock[]
  boards             SubscriptionAdvisor[]
  tags               AdvisorTag[]
}

/// Kompetence-tag. Bruges til at matche kundens behov (onboarding-testen) med rådgivere.
model Tag {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)

  advisors AdvisorTag[]
  weights  AnswerTagWeight[]
}

model AdvisorTag {
  advisorId String
  tagId     String
  advisor   AdvisorProfile @relation(fields: [advisorId], references: [userId], onDelete: Cascade)
  tag       Tag            @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([advisorId, tagId])
  @@index([tagId])
}

enum QuestionType {
  SINGLE
  MULTI
}

/// Spørgsmål i onboarding-testen (redigeres i admin-CMS).
model OnboardingQuestion {
  id        String       @id @default(cuid())
  text      String
  helpText  String?
  type      QuestionType @default(SINGLE)
  sortOrder Int          @default(0)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())

  answers OnboardingAnswer[]
}

model OnboardingAnswer {
  id         String             @id @default(cuid())
  questionId String
  text       String
  sortOrder  Int                @default(0)
  /// Valgfri: dette svar angiver boardets størrelse (2, 3 eller 4).
  boardSize  Int?
  question   OnboardingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  weights AnswerTagWeight[]

  @@index([questionId])
}

model AnswerTagWeight {
  answerId String
  tagId    String
  /// 1-5
  weight   Int
  answer   OnboardingAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  tag      Tag              @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([answerId, tagId])
  @@index([tagId])
}

/// Server-side tilstand for en igangværende tilmelding. Slettes ved gennemført betaling og ellers efter udløb (7 dage).
model OnboardingSession {
  id            String   @id @default(cuid())
  /// SHA-256 hex af cookie-tokenet
  tokenHash     String   @unique
  step          Int      @default(1)
  data          Json     @default("{}")
  answers       Json     @default("{}")
  suggestedBoard Json    @default("{}")
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  @@index([expiresAt])
}

model CustomerProfile {
  userId       String @id
  companyName  String
  cvr          String
  address      String @default("")
  billingEmail String
  /// Virksomhedsdata fra CVR-registret (snapshot ved tilmelding), eller manuelt indtastet.
  cvrData      Json?
  /// false = navn og adresse er indtastet manuelt (ikke verificeret mod CVR)
  cvrVerified  Boolean @default(false)
  /// Snapshot af onboarding-testen: spørgsmåls- og svartekster, behov og foreslået board.
  testAnswers  Json?
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subscriptions Subscription[]
}

model AvailabilityRule {
  id          String         @id @default(cuid())
  advisorId   String
  /// ISO weekday: Monday = 1 ... Sunday = 7
  weekday     Int
  /// Minutes after local (Europe/Copenhagen) midnight
  startMinute Int
  endMinute   Int
  advisor     AdvisorProfile @relation(fields: [advisorId], references: [userId], onDelete: Cascade)

  @@index([advisorId])
}

model AvailabilityBlock {
  id        String         @id @default(cuid())
  advisorId String
  startsAt  DateTime
  endsAt    DateTime
  reason    String         @default("")
  advisor   AdvisorProfile @relation(fields: [advisorId], references: [userId], onDelete: Cascade)

  @@index([advisorId, startsAt])
}

model Subscription {
  id                     String             @id @default(cuid())
  customerId             String
  advisorCount           Int
  frequencyWeeks         Int
  monthlyPriceDkk        Int
  status                 SubscriptionStatus @default(PENDING)
  provider               String             @default("mock")
  providerSubscriptionId String?
  providerCustomerId     String?
  startedAt              DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime           @default(now())
  customer               CustomerProfile    @relation(fields: [customerId], references: [userId], onDelete: Cascade)

  advisors SubscriptionAdvisor[]
  meetings Meeting[]

  @@index([customerId])
  @@index([providerSubscriptionId])
}

model SubscriptionAdvisor {
  subscriptionId String
  advisorId      String
  /// Rådgiverens pris pr. møde (ekskl. moms) fastfrosset på købstidspunktet / ved planskift.
  pricePerMeetingDkk Int @default(1750)
  subscription   Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  advisor        AdvisorProfile @relation(fields: [advisorId], references: [userId], onDelete: Cascade)

  @@id([subscriptionId, advisorId])
}

model Meeting {
  id                String        @id @default(cuid())
  subscriptionId    String
  startsAt          DateTime
  endsAt            DateTime
  status            MeetingStatus @default(BOOKED)
  roomUrl           String?
  hostRoomUrl       String?
  providerMeetingId String?
  createdById       String?
  cancelledAt       DateTime?
  createdAt         DateTime      @default(now())
  subscription      Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  participants MeetingParticipant[]
  recordings   Recording[]
  transcript   Transcript?

  @@index([subscriptionId])
  @@index([startsAt])
}

model MeetingParticipant {
  meetingId String
  userId    String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
  @@index([userId])
}

model Recording {
  id         String          @id @default(cuid())
  meetingId  String
  storageKey String?
  mime       String?
  source     RecordingSource
  status     RecordingStatus @default(RECEIVED)
  error      String?
  createdAt  DateTime        @default(now())
  meeting    Meeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model Transcript {
  id        String   @id @default(cuid())
  meetingId String   @unique
  text      String
  segments  Json?
  summary   String?
  language  String   @default("da")
  createdAt DateTime @default(now())
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  externalId  String    @unique
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
}

model Job {
  id        String    @id @default(cuid())
  type      String
  payload   Json
  status    JobStatus @default(PENDING)
  attempts  Int       @default(0)
  runAt     DateTime  @default(now())
  lockedAt  DateTime?
  error     String?
  createdAt DateTime  @default(now())

  @@index([status, runAt])
}
