generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ADVISOR
  CUSTOMER
}

enum TokenPurpose {
  INVITE
  RESET
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum MeetingStatus {
  BOOKED
  COMPLETED
  CANCELLED
}

enum RecordingSource {
  WEBHOOK
  UPLOAD
}

enum RecordingStatus {
  /// Upload startet (presigned/streamet), endnu ikke verificeret. Ryddes op efter 24 timer.
  UPLOADING
  RECEIVED
  TRANSCRIBING
  DONE
  FAILED
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  role         Role
  name         String
  phone        String?
  createdAt    DateTime  @default(now())
  /// GDPR: set when the user has asked for deletion; admin processes it.
  deletionRequestedAt DateTime?
  /// GDPR: timestamp of consent to terms/privacy at signup.
  consentAt    DateTime?
  /// Eksplicit samtykke til optagelse og transskription af møder (givet ved oprettelse/invitation, ellers ved næste login).
  recordingConsentAt      DateTime?
  recordingConsentVersion String?
  /// Afmelding af ikke-obligatoriske beskeder pr. kanal (afmeldingslink, STOP-svar eller under Konto).
  emailOptOutAt DateTime?
  smsOptOutAt   DateTime?
  /// Login-spærring pr. konto (H-2): fejlede forsøg i træk, seneste fejl og spærret indtil.
  failedLoginCount  Int       @default(0)
  lastFailedLoginAt DateTime?
  lockedUntil       DateTime?
  /// Seneste fuldt gennemførte login (efter evt. totrinsbekræftelse). Vises i Admin → Administratorer.
  lastLoginAt       DateTime?
  /// Deaktiveret (administratorer): kan ikke logge ind; sessioner og betroede enheder er tilbagekaldt.
  deactivatedAt     DateTime?

  /// Totrinsbekræftelse (TOTP, RFC 6238). Påkrævet for ADMIN, valgfri for andre. Hemmeligheden er krypteret
  /// (AES-256-GCM, `src/lib/mfa/crypto.ts`) og aldrig i klartekst i databasen.
  mfaEnabledAt        DateTime?
  mfaSecretEnc        String?
  /// Id for nøglen, hemmeligheden er krypteret med (rotation: MFA_ENCRYPTION_KEY / MFA_ENCRYPTION_KEY_PREVIOUS).
  mfaKeyId            String?
  /// Opsætning i gang: ny hemmelighed, der først aktiveres, når brugeren har bekræftet med en gyldig kode.
  mfaPendingSecretEnc String?
  mfaPendingCreatedAt DateTime?
  /// Seneste brugte TOTP-tidstrin (afviser genbrug af en kode, replay).
  mfaLastUsedStep     Int?
  /// Fejlede koder i træk (egen tæller, så et korrekt password ikke nulstiller den). Spærring deles med login (lockedUntil).
  mfaFailedCount      Int       @default(0)
  mfaLastFailedAt     DateTime?

  sessions        Session[]
  trustedDevices  TrustedDevice[]
  recoveryCodes   MfaRecoveryCode[]
  passwordTokens  PasswordToken[]
  advisorProfile  AdvisorProfile?
  customerProfile CustomerProfile?
  participations  MeetingParticipant[]
  auditLogs       AuditLog[]
  notificationLogs NotificationLog[]
  marketingConsents MarketingConsent[]
}

model Session {
  /// SHA-256 hex of the random cookie token.
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  /// true = adgangskoden er godkendt, men totrinsbekræftelsen (kode eller opsætning) mangler. Sådan en session giver
  /// kun adgang til /mfa-siderne og log ud; den udløber efter 15 minutter og erstattes af en ny ved bekræftelse.
  mfaPending    Boolean   @default(false)
  /// Seneste bekræftelse med kode i denne session (følsomme admin-handlinger kræver højst 15 minutter siden).
  mfaVerifiedAt DateTime?
  /// Login uden kode, fordi enheden er betroet («Husk denne enhed»).
  trustedDeviceId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Betroet enhed («Husk denne enhed i 30 dage»): cookien `abu_device` holder et tilfældigt token, her gemmes kun dets
/// SHA-256. Udløbet forlænges ikke ved brug. Adgangskoden kræves altid; kun koden springes over.
model TrustedDevice {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  /// Grov beskrivelse ud fra user-agent, fx «Chrome på macOS»
  label      String
  /// Omtrentlig IP (IPv4 /24, IPv6 /48), fx «203.0.113.0/24»
  ipPrefix   String?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Engangs-gendannelseskoder til totrinsbekræftelse. Kun SHA-256 gemmes; koderne vises én gang.
model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
}

model PasswordToken {
  id        String       @id @default(cuid())
  userId    String
  tokenHash String       @unique
  purpose   TokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AdvisorProfile {
  userId    String   @id
  title     String   @default("")
  bio       String   @default("")
  /// Profilbillede i lageret (`avatars/<userId>/<tilfældig>.webp` + `-96.webp`). Null = initialer. Bucketten er privat;
  /// billedet serveres af `/api/avatar/<userId>`.
  photoKey       String?
  /// Tidspunkt for seneste upload – bruges som version i billed-URL'en (?v=…), så den kan caches som immutable.
  photoUpdatedAt DateTime?
  /// Rådgivere aktiveres manuelt af admin, når de er klar (QA #13). Indtil da kan kunder ikke vælge dem.
  active    Boolean  @default(false)
  /// Pris pr. møde i hele kroner, ekskl. moms. Sættes af admin. Fastfryses på abonnementet ved køb.
  pricePerMeetingDkk Int @default(1750)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  availabilityRules  AvailabilityRule[]
  availabilityBlocks AvailabilityBlock[]
  boards             SubscriptionAdvisor[]
  tags               AdvisorTag[]
}

/// COMPETENCE: kompetence-tag (matching, katalog, kunder ser det). ADMIN: internt tag, kun synligt for admin.
enum TagKind {
  COMPETENCE
  ADMIN
}

/// Tag på rådgivere. Kompetence-tags matcher kundens behov (onboarding-testen); admin-tags er interne mærkater
/// (fx «Lead-kvalificeret») og vises aldrig for kunder eller rådgivere og bruges ikke i matching.
model Tag {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  kind        TagKind  @default(COMPETENCE)
  /// Systemtag med fast nøgle (fx "lead"). Kan ikke slettes eller deaktiveres; navnet kan ændres.
  systemKey   String?  @unique

  advisors AdvisorTag[]
  weights  AnswerTagWeight[]
}

model AdvisorTag {
  advisorId String
  tagId     String
  advisor   AdvisorProfile @relation(fields: [advisorId], references: [userId], onDelete: Cascade)
  tag       Tag            @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([advisorId, tagId])
  @@index([tagId])
}

enum QuestionType {
  SINGLE
  MULTI
}

/// Spørgsmål i onboarding-testen (redigeres i admin-CMS).
model OnboardingQuestion {
  id        String       @id @default(cuid())
  text      String
  helpText  String?
  type      QuestionType @default(SINGLE)
  sortOrder Int          @default(0)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())

  answers OnboardingAnswer[]
}

model OnboardingAnswer {
  id         String             @id @default(cuid())
  questionId String
  text       String
  sortOrder  Int                @default(0)
  /// Valgfri: dette svar angiver boardets størrelse (2, 3 eller 4).
  boardSize  Int?
  question   OnboardingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  weights AnswerTagWeight[]

  @@index([questionId])
}

model AnswerTagWeight {
  answerId String
  tagId    String
  /// 1-5
  weight   Int
  answer   OnboardingAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  tag      Tag              @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([answerId, tagId])
  @@index([tagId])
}

/// Server-side tilstand for en igangværende tilmelding. Slettes ved gennemført betaling og ellers efter udløb (7 dage).
model OnboardingSession {
  id            String   @id @default(cuid())
  /// SHA-256 hex af cookie-tokenet
  tokenHash     String   @unique
  step          Int      @default(1)
  data          Json     @default("{}")
  answers       Json     @default("{}")
  suggestedBoard Json    @default("{}")
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  /// Lead oprettet i trin 1 (navn, e-mail og evt. markedsføringssamtykke gemmes, selv om tilmeldingen aldrig gøres færdig).
  leadId        String?
  lead          Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@index([leadId])
}

/// Kontaktperson fra onboarding trin 1. Oprettes, så snart trin 1 er sendt – også hvis tilmeldingen aldrig gøres færdig.
/// Uden samtykke og uden gennemførelse slettes leadet, når sessionen udløber; med samtykke gemmes det, til samtykket
/// trækkes tilbage eller opbevaringsperioden (LEAD_RETENTION_MONTHS) er gået.
model Lead {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  phone          String?
  /// Højeste trin nået (1-6)
  step           Int       @default(1)
  source         String    @default("onboarding_trin1")
  createdAt      DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  /// Sat, når personen har oprettet konto
  convertedAt    DateTime?
  userId         String?

  sessions OnboardingSession[]
  consents MarketingConsent[]

  @@index([lastActivityAt])
}

/// Markedsføringssamtykke (e-mail og/eller SMS) med den præcise tekst, personen så, og versionen af den.
model MarketingConsent {
  id               String    @id @default(cuid())
  leadId           String?
  userId           String?
  email            String
  phone            String?
  emailConsent     Boolean   @default(true)
  smsConsent       Boolean   @default(true)
  consentedAt      DateTime  @default(now())
  /// Snapshot af samtykketeksten på afkrydsningstidspunktet
  text             String
  textVersion      String
  source           String
  ipAddress        String?
  userAgent        String?
  emailWithdrawnAt DateTime?
  smsWithdrawnAt   DateTime?
  lead             Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user             User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([leadId])
  @@index([userId])
}

/// Redigerbare tekster (onboarding). Kun ændrede tekster ligger her; manglende nøgler falder tilbage til standardteksten i koden.
model ContentBlock {
  key         String   @id
  value       String
  /// Hæves ved hver ændring (bruges som version af samtykketekster)
  version     Int      @default(1)
  updatedAt   DateTime @updatedAt
  updatedById String?
}

model CustomerProfile {
  userId       String @id
  companyName  String
  cvr          String
  address      String @default("")
  billingEmail String
  /// Virksomhedsdata fra CVR-registret (snapshot ved tilmelding), eller manuelt indtastet.
  cvrData      Json?
  /// false = navn og adresse er indtastet manuelt (ikke verificeret mod CVR)
  cvrVerified  Boolean @default(false)
  /// Snapshot af onboarding-testen: spørgsmåls- og svartekster, behov og foreslået board.
  testAnswers  Json?
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subscriptions Subscription[]
}

model AvailabilityRule {
  id          String         @id @default(cuid())
  advisorId   String
  /// ISO weekday: Monday = 1 ... Sunday = 7
  weekday     Int
  /// Minutes after local (Europe/Copenhagen) midnight
  startMinute Int
  endMinute   Int
  advisor     AdvisorProfile @relation(fields: [advisorId], references: [userId], onDelete: Cascade)

  @@index([advisorId])
}

model AvailabilityBlock {
  id        String         @id @default(cuid())
  advisorId String
  startsAt  DateTime
  endsAt    DateTime
  reason    String         @default("")
  advisor   AdvisorProfile @relation(fields: [advisorId], references: [userId], onDelete: Cascade)

  @@index([advisorId, startsAt])
}

model Subscription {
  id                     String             @id @default(cuid())
  customerId             String
  advisorCount           Int
  frequencyWeeks         Int
  monthlyPriceDkk        Int
  status                 SubscriptionStatus @default(PENDING)
  provider               String             @default("mock")
  providerSubscriptionId String?
  providerCustomerId     String?
  startedAt              DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime           @default(now())
  customer               CustomerProfile    @relation(fields: [customerId], references: [userId], onDelete: Cascade)

  advisors SubscriptionAdvisor[]
  meetings Meeting[]

  @@index([customerId])
  @@index([providerSubscriptionId])
}

model SubscriptionAdvisor {
  subscriptionId String
  advisorId      String
  /// Rådgiverens pris pr. møde (ekskl. moms) fastfrosset på købstidspunktet / ved planskift.
  pricePerMeetingDkk Int @default(1750)
  /// Ansvarlig rådgiver (lead) for boardet. Højst én pr. abonnement (delvist unikt indeks i migrationen
  /// `WHERE "isLead"`); præcis én for PENDING/ACTIVE/PAST_DUE, og kun en rådgiver med lead-tagget (src/lib/lead.ts).
  isLead         Boolean        @default(false)
  subscription   Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  advisor        AdvisorProfile @relation(fields: [advisorId], references: [userId], onDelete: Cascade)

  @@id([subscriptionId, advisorId])
}

model Meeting {
  id                String        @id @default(cuid())
  subscriptionId    String
  startsAt          DateTime
  endsAt            DateTime
  status            MeetingStatus @default(BOOKED)
  roomUrl           String?
  hostRoomUrl       String?
  providerMeetingId String?
  createdById       String?
  cancelledAt       DateTime?
  createdAt         DateTime      @default(now())
  subscription      Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  participants MeetingParticipant[]
  recordings   Recording[]
  transcript   Transcript?

  @@index([subscriptionId])
  @@index([startsAt])
}

model MeetingParticipant {
  meetingId String
  userId    String
  addedAt   DateTime @default(now())
  /// Rådgiverens mødepris (ekskl. moms) for netop dette møde, til senere afregning pr. faktisk deltager.
  pricePerMeetingDkk Int?
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
  @@index([userId])
}

model Recording {
  id         String          @id @default(cuid())
  meetingId  String
  storageKey String?
  mime       String?
  source     RecordingSource
  status     RecordingStatus @default(RECEIVED)
  /// Hvem uploadede (kun UPLOAD), og filens størrelse efter verifikation
  uploadedById String?
  sizeBytes    Int?
  error      String?
  createdAt  DateTime        @default(now())
  meeting    Meeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model Transcript {
  id        String   @id @default(cuid())
  meetingId String   @unique
  text      String
  segments  Json?
  summary   String?
  language  String   @default("da")
  createdAt DateTime @default(now())
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  externalId  String    @unique
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  /// Valgfri uddybning (fx intern note ved udskiftning af rådgiver).
  detail    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
}

model Job {
  id        String    @id @default(cuid())
  type      String
  payload   Json
  status    JobStatus @default(PENDING)
  attempts  Int       @default(0)
  runAt     DateTime  @default(now())
  lockedAt  DateTime?
  error     String?
  createdAt DateTime  @default(now())

  @@index([status, runAt])
}

// ------------------------------------------------------------------ Notifikationer

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationAudience {
  CUSTOMER
  ADVISORS
  BOTH
  /// Personen hændelsen handler om (invitation, nulstilling, ufærdig tilmelding).
  SUBJECT
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

/// Tekst til en besked. Brødtekst bruger {{variabler}}; ukendte variabler afvises i CMS'et.
model NotificationTemplate {
  id        String              @id @default(cuid())
  /// Stabil nøgle for standardtekster (tom for egne skabeloner)
  key       String?             @unique
  channel   NotificationChannel
  name      String
  subject   String?
  body      String
  active    Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  rules NotificationRule[]
}

/// Hvornår (trigger + offset), til hvem og med hvilken tekst en besked sendes.
model NotificationRule {
  id            String               @id @default(cuid())
  trigger       String
  /// Minutter i forhold til hændelsen. Negativ = før (fx -1440 = 24 timer før mødet), positiv = efter.
  offsetMinutes Int                  @default(0)
  channel       NotificationChannel
  templateId    String
  audience      NotificationAudience
  active        Boolean              @default(true)
  /// SMS: respekter stille timer (undtagen påmindelser tæt på mødet).
  quietHours    Boolean              @default(false)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  template      NotificationTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  logs NotificationLog[]

  @@index([trigger, active])
}

/// Hver planlagt og udsendt besked. Slettes efter opbevaringsperioden og sammen med kontoen.
model NotificationLog {
  id                String              @id @default(cuid())
  ruleId            String?
  templateKey       String
  trigger           String
  channel           NotificationChannel
  recipientUserId   String?
  recipientAddress  String
  entityType        String
  entityId          String
  /// Skelner flere forekomster for samme regel/enhed/modtager (fx påmindelser efter flytning af mødet).
  dedupe            String              @default("")
  status            NotificationStatus  @default(QUEUED)
  providerMessageId String?
  error             String?
  subject           String?
  /// Første del af den sendte tekst (til loggen i CMS'et)
  preview           String?
  /// Ekstra kontekst til oprendering (fx hvem der er tilføjet/fjernet)
  context           Json?
  scheduledFor      DateTime
  claimedAt         DateTime?
  sentAt            DateTime?
  createdAt         DateTime            @default(now())
  rule              NotificationRule?   @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  recipient         User?               @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([ruleId, entityId, recipientAddress, dedupe])
  @@index([status, scheduledFor])
  @@index([entityType, entityId])
  @@index([recipientUserId])
  @@index([providerMessageId])
  @@index([createdAt])
}

/// Enkle indstillinger der kan ændres i CMS'et (stille timer, SMS-afsender, opbevaring af log).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Fælles lager til rate limits (H-2/L-2): overlever genstart og deles mellem instanser. Nøglen er SHA-256 af den logiske nøgle.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

/// Fælles cache for CVR-opslag (M-4/L-2), også for "ikke fundet". Fejl caches ikke.
model CvrLookupCache {
  cvr       String   @id
  result    Json
  expiresAt DateTime

  @@index([expiresAt])
}

/// Idempotens for formularer (QA #1): et gentaget kald med samme nøgle returnerer det første resultat i stedet for en fejl.
/// id = SHA-256 af bruger + handling + klientens nøgle. Ryddes op efter udløb.
model IdempotencyKey {
  id        String   @id
  userId    String
  scope     String
  result    Json?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}
